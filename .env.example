# Copy to `.env` and adjust for your Raspberry Pi / USB-UART adapter.
CONTAINER_NAME=cartpole-ddpg
IMAGE_NAME=cartpole-ddpg:pi

# Prefer a stable by-id path when available, e.g.:
# SERIAL_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
SERIAL_PORT=/dev/ttyUSB0
SERIAL_SPEED=500000

CHECKPOINT=outputs/ddpg_simba_small_push_seed42/ddpg_model.pt
THETA_OFFSET=-2.201221
